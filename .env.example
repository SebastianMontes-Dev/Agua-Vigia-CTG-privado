# .env es OPCIONAL (ADR-086): `docker compose up` funciona sin él. Cópialo a .env solo para cambiar un valor por defecto.
# .env NUNCA se versiona (ver .gitignore).
# Referenciado por docker-compose.yml y por .mcp.json (servidor mongodb, Sprint 1).
# El proyecto corre solo en local (ADR-057, ADR-080): no hay variables de despliegue.

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# --- MongoDB ---
# replicaSet=rs0: Mongo local corre como replica set de un nodo para las transacciones (ADR-063).
MONGODB_URI=mongodb://mongo:27017/aguavigia?replicaSet=rs0
MONGO_INITDB_DATABASE=aguavigia

# --- Redis (cache, rate limiting, ventana de consenso, pub/sub) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Mailhog (SMTP de pruebas, M4 alertas por correo) ---
MAIL_HOST=mailhog
MAIL_PORT=1025

# --- Identificacion del colector (ver CLAUDE.md, etica de datos, punto 3) ---
# El colector SIEMPRE se identifica. Correo de contacto real definido 2026-08-08 (BL-006).
COLLECTOR_USER_AGENT=AguaVigiaCTG-Bot/1.0 (+alertas@aguavigia.com)
# Cada cuanto corre el ciclo de ingesta (M9), en milisegundos. 600000 = 10 minutos.
INGESTA_INTERVALO_MS=600000
# auto (por defecto): Acuacar y la prensa en vivo y, si Acuacar falla (sin red, sitio caído), los boletines reales guardados en
# el repositorio. en-vivo es lo mismo sin ese respaldo; local no usa la red y lee solo los boletines guardados, para presentar
# sin internet (ADR-082). Cambiarlo exige recrear el backend: docker compose up -d backend.
INGESTA_MODO=auto

# --- Instancia real: sembrado y topes ---
# Cuentas sintéticas de vecino que el backend crea al arrancar (lo único inventado; 0 las desactiva).
VECINOS_SINTETICOS=30000
# Multiplica los topes por IP de dispositivos, reportes y fotos (tope 1000). 1 en uso normal; súbelo solo para pruebas de carga o
# siembras desde un mismo equipo. No afloja el ingreso, el segundo factor, el cambio de clave ni los correos: esos solo los mueve
# RATE_LIMIT_FACTOR_CUENTAS, que no se declara aquí a propósito (solo la simulación lo usa; el backend avisa en el log si es >1).
RATE_LIMIT_FACTOR=1
# Redes distintas que exige el quórum de un barrio. 1 en local: con Docker Desktop todos los clientes comparten IP (ADR-090).
AGUAVIGIA_CONSENSO_REDES_MINIMAS=1

# --- Seguridad (panel del veedor, M5 — RF019, RNF011, ADR-039, ADR-086) ---
# Las tres son opcionales y van comentadas a propósito: una variable presente pero VACÍA tapa el valor por defecto.
#
# Firma del JWT. Sin ella, el perfil docker genera una aleatoria en cada arranque (las sesiones no sobreviven a un
# reinicio). HS256 exige mínimo 32 bytes: openssl rand -base64 32
# JWT_SECRET=
#
# Hash BCrypt de la clave del PRIMER administrador, nunca la clave en claro (GenerarHashVeedor, en
# backend/src/test/.../infrastructure/security/). Sin él, el backend inventa una clave aleatoria y la escribe una sola
# vez en su log: docker compose logs backend. Solo se usa si la base no tiene ninguna cuenta.
# VEEDOR_PASSWORD_HASH=
#
# Correo del primer administrador (por defecto admin@aguavigia.local). Nace ADMIN y exige segundo factor: su primera
# sesión solo sirve para darlo de alta.
# ADMIN_INICIAL_CORREO=admin@aguavigia.local
# Clave compartida para sensores IoT (M13). Vacía por defecto: POST /api/iot/presion responde 503 hasta que se
# configure. Exige al menos 32 caracteres o el backend no arranca (p. ej. `openssl rand -hex 16`, que da 32) y mándalo
# en la cabecera X-IoT-Key.
IOT_KEY=
# Token del bot de Telegram (RF041), el que entrega @BotFather. Vacío por defecto: las alertas por Telegram quedan
# desactivadas y el resto de la plataforma funciona igual. Ver docs/ingenieria/telegram.md.
TELEGRAM_BOT_TOKEN=

# --- Enlaces de los correos ---
# Base publica desde la que se arman los enlaces que salen por correo (confirmar suscripcion,
# verificar cuenta, aceptar invitacion, restablecer clave). En local, el 8081 del backend.
APP_URL_PUBLICA=http://localhost:8081
# URL pública de la SPA para los enlaces de avisos y sectores (ADR-078).
APP_URL_FRONTEND=http://localhost:5173

# --- GitHub (servidor MCP $disabled_github en .mcp.json, opcional) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- CORS del entorno local (perfil docker) ---
# Orígenes desde los que el navegador puede llamar a la API cuando el frontend corre en su propio
# dev server. Lista separada por comas. Incluye Vite (5173), su preview E2E (4173), React/Next (3000) y Angular (4200).
CORS_ORIGENES=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost:4200
